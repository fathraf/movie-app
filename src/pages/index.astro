	---
	import { movies } from '../data/movies';
	import MovieCard from '../components/MovieCard.astro';
	---

	<html lang="en">
		<head>
			<meta charset="utf-8" />
			<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
			<meta name="viewport" content="width=device-width" />
			<meta name="generator" content={Astro.generator} />
			<link rel="stylesheet" href="/styles/global.css">

			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=search" />
			<title>YouTube Movies Collections</title>
		</head>
		<body>
			<header class="header">
				<h1 class="header__title">MovieFlix</h1>
				<div class="header__search">
					<input type="search" class="header__search-input" id="searchInput" placeholder="Search movies...">
					<span class="header__search-icon material-symbols-outlined">search</span>
				</div>
			</header>

			<main class="movies">
				<div class="movies__grid">
					{movies.map((movie) => <MovieCard movie={movie} />)}
				</div>

				<p class="no-results" style="display: none;">No movies found!</p>
			</main>

			<script src="/scripts/search.js" type="module" is:inline></script>

	</body>
</html>
